plan "Two-storey Townhouse" {
  units mm
  grid 50
  paper A3 landscape
  north up
  dims auto all

  # Settings and the plan-global constants live outside the levels: one building,
  # one sheet, one scale. Each `level` block is a whole storey — its own drawing.
  let W    = 7600
  let D    = 9000
  let T    = 200
  let HALL = 2400   # the stair hall runs the full depth on the west side

  level 0 "Ground floor" {
    wall id=shell  exterior  thickness T   { (0,0) (W,0) (W,D) (0,D) close }
    wall id=w_hall partition thickness 100 { (HALL,0) (HALL,D) }
    wall id=w_kit  partition thickness 100 { (HALL,4600) (W,4600) }
    wall id=w_wc   partition thickness 100 { (0,6400) (HALL,6400) }

    room id=r_hall    at (0,0)       size 2400x6400 label "Hall"            uses hall circulation
    room id=r_wc      at (0,6400)    size 2400x2600 label "WC"              uses wc
    room id=r_living  at (HALL,0)    size 5200x4600 label "Living / Dining" uses living dining
    room id=r_kitchen at (HALL,4600) size 5200x4400 label "Kitchen"         uses kitchen

    door    id=d_front   on shell at 1200 width 1000 hinge left swing into r_hall
    door    id=d_living  on w_hall at 1800 width 900 swing into r_living
    door    id=d_kitchen on w_hall at 5400 width 900 swing into r_kitchen
    door    id=d_wc      on w_wc   at 1500 width 800 swing into r_wc
    opening id=o_kit     on w_kit  at 2400 width 1400

    window id=win_liv_n at (4800,0)    width 1600 wall shell
    window id=win_liv_e at (7600,2200) width 1800 wall shell
    window id=win_kit_e at (7600,6800) width 1400 wall shell
    window id=win_kit_s at (4800,9000) width 1600 wall shell
    window id=win_hall  at (0,900)     width 900  wall shell
    window id=win_wc    at (1500,9000) width 600  wall shell

    furniture id=f_sofa  sofa  in r_living anchor top-right flush inset 400 size 2200x900
    furniture id=f_table table in r_living anchor bottom-right flush inset 400 size 1400x900 label "Dining"
    furniture id=f_sink   kitchen_sink against wall shell segment 2 offset 1200 in r_kitchen
    furniture id=f_stove  stove        against wall shell segment 2 offset 2000 in r_kitchen
    furniture id=f_fridge fridge       against wall shell segment 2 offset 2800 in r_kitchen
    furniture id=f_wcp   wc    in r_wc anchor bottom-right flush size 400x700
    furniture id=f_basin basin in r_wc anchor right        flush size 450x600

    # One shaft, declared on both storeys by the SAME id.
    stair id=stair at (300,2600) size 900x3000 dir up
  }

  level 1 "First floor" {
    wall id=shell  exterior  thickness T   { (0,0) (W,0) (W,D) (0,D) close }
    wall id=w_hall partition thickness 100 { (HALL,0) (HALL,D) }
    wall id=w_bed  partition thickness 100 { (HALL,4600) (W,4600) }
    wall id=w_bath partition thickness 100 { (0,6400) (HALL,6400) }

    room id=r_landing at (0,0)       size 2400x6400 label "Landing"   uses circulation
    room id=r_bath    at (0,6400)    size 2400x2600 label "Bath"      uses bath
    room id=r_bed1    at (HALL,0)    size 5200x4600 label "Bedroom 1" uses bedroom
    room id=r_bed2    at (HALL,4600) size 5200x4400 label "Bedroom 2" uses bedroom

    # No front door up here: the stair below carries the same id, so the access
    # graph reaches this storey through the shaft.
    door id=d_bed1 on w_hall at 1800 width 900 swing into r_bed1
    door id=d_bed2 on w_hall at 5400 width 900 swing into r_bed2
    door id=d_bath on w_bath at 1500 width 800 swing into r_bath

    window id=win_b1_n at (4800,0)    width 1600 wall shell
    window id=win_b1_e at (7600,2200) width 1400 wall shell
    window id=win_b2_s at (4800,9000) width 1600 wall shell
    window id=win_b2_e at (7600,6800) width 1200 wall shell
    window id=win_land at (0,900)     width 900  wall shell
    window id=win_bath at (1500,9000) width 600  wall shell

    furniture id=f_bed1  bed      in r_bed1 anchor top-right flush inset 400 size 1600x2100 label "Double"
    furniture id=f_ward1 wardrobe in r_bed1 anchor bottom flush size 1800x600
    furniture id=f_bed2  bed      in r_bed2 anchor bottom-right flush inset 400 size 1400x2000 label "Double"
    furniture id=f_ward2 wardrobe in r_bed2 anchor top flush size 1600x600
    furniture id=f_tub   bathtub in r_bath anchor bottom flush size 1700x750
    furniture id=f_wcp   wc      in r_bath anchor right  flush size 700x400
    furniture id=f_basin basin   in r_bath anchor left   flush size 450x600

    stair id=stair at (300,2600) size 900x3000 dir down
  }

  title { project "Two-storey Townhouse" drawn_by "ArchCanvas" }
}
