plan "Courtyard Apartment" {
  units mm
  grid 50
  paper A3 landscape
  north up
  dims auto all

  # Positioning axes: the structural datum lines every dimension is read from.
  axes {
    x at 0, 4800, 8400, 11000
    y at 0, 4400, 5600, 8400
  }

  wall id=shell   exterior  thickness 200 { (0,0) (11000,0) (11000,8400) (0,8400) close }
  wall id=w_court partition thickness 100 { (4800,0) (4800,8400) }
  wall id=w_south partition thickness 100 { (4800,4400) (11000,4400) }
  wall id=w_hall  partition thickness 100 { (4800,5600) (11000,5600) }
  wall id=w_bath  partition thickness 100 { (8400,5600) (8400,8400) }

  # Day and night halves declared as zones — grouping only, zero geometry.
  zone day "Day" {
    room id=r_living at (0,0)    size 4800x8400 label "Living / Kitchen" uses living kitchen dining
    room id=r_court  at (4800,0) size 6200x4400 label "Courtyard"
  }
  zone night "Night" {
    room id=r_hall at (4800,4400) size 6200x1200 label "Hall"    uses hall circulation
    room id=r_bed  at (4800,5600) size 3600x2800 label "Bedroom" uses bedroom
    room id=r_bath at (8400,5600) size 2600x2800 label "Bath"    uses bath
  }

  door    id=d_front on shell   at 26800 width 1000 hinge left swing into r_living
  opening id=o_court on w_court at 2400  width 1600
  door    id=d_hall  on w_court at 5000  width 900  swing into r_hall
  door    id=d_bed   on w_hall  at 2800  width 800  swing into r_bed
  door    id=d_bath  on w_hall  at 4200  width 800  swing into r_bath

  window id=win_n    at (2400,0)     width 1800 wall shell
  window id=win_w1   at (0,2600)     width 1400 wall shell
  window id=win_w2   at (0,6200)     width 1400 wall shell
  window id=win_bed  at (6300,8400)  width 1600 wall shell
  window id=win_bath at (11000,6800) width 600  wall shell
  window id=win_hall at (11000,5000) width 900  wall shell

  furniture id=f_sink   kitchen_sink against wall shell segment 0 offset 700  in r_living
  furniture id=f_stove  stove        against wall shell segment 0 offset 1550 in r_living
  furniture id=f_fridge fridge       against wall shell segment 0 offset 2350 in r_living
  furniture id=f_table  table in r_living anchor left inset 400 size 1400x900 label "Dining"
  furniture id=f_sofa   sofa  in r_living anchor bottom-left flush inset 400 size 2000x900
  furniture id=f_bed    bed   in r_bed anchor bottom-left flush inset 300 size 1500x2000 label "Double"
  furniture id=f_ward   wardrobe in r_bed anchor bottom-right flush size 1400x600
  furniture id=f_basin  basin  in r_bath anchor top-right    flush size 600x450
  furniture id=f_wc     wc     in r_bath anchor bottom-right flush size 400x700
  furniture id=f_shower shower in r_bath anchor bottom-left  flush size 900x900

  title { project "Courtyard Apartment" drawn_by "ArchCanvas" }
}
