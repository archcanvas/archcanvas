plan "Gallery Wing" {
  units mm
  grid 100
  paper A2 landscape
  north up
  dims auto all
  schedule rooms

  # Both long facades bow outward. An `arc` clause makes that edge a true
  # circular arc — the faces draw as arcs, openings walk the real run length,
  # and `dims auto` adds a radius leader for each one.
  wall id=shell exterior thickness 300 {
    (0,0) (8000,0) arc (18000,0) radius 9000 cw (26000,0)
    (26000,17000) (18000,17000) arc (8000,17000) radius 9000 cw (0,17000) close
  }
  wall id=w_spine partition thickness 200 { (0,10500) (26000,10500) }
  wall id=w_b1    partition thickness 200 { (8000,0) (8000,10500) }
  wall id=w_b2    partition thickness 200 { (18000,0) (18000,10500) }
  wall id=w_south partition thickness 200 { (0,13000) (26000,13000) }
  wall id=w_s1    partition thickness 200 { (8000,13000) (8000,17000) }
  wall id=w_s2    partition thickness 200 { (13000,13000) (13000,17000) }
  wall id=w_s3    partition thickness 200 { (19000,13000) (19000,17000) }
  wall id=w_s4    partition thickness 200 { (22000,13000) (22000,17000) }

  zone galleries "Galleries" {
    room id=r_g1 at (0,0)     size 8000x10500  label "Gallery A"
    room id=r_g2 at (8000,0)  size 10000x10500 label "Gallery B"
    room id=r_g3 at (18000,0) size 8000x10500  label "Gallery C"
  }
  zone visitor "Visitor services" {
    room id=r_concourse at (0,10500)     size 26000x2500 label "Concourse" uses circulation
    room id=r_foyer     at (0,13000)     size 8000x4000  label "Foyer"     uses entry
    room id=r_shop      at (8000,13000)  size 5000x4000  label "Shop"      uses storage
    room id=r_cafe      at (13000,13000) size 6000x4000  label "Cafe"      uses dining
    room id=r_wc        at (19000,13000) size 3000x4000  label "WC"        uses wc
  }
  zone back "Back of house" {
    room id=r_plant at (22000,13000) size 4000x4000 label "Plant" uses utility
  }

  # The entrance is on the straight run of the south facade, opening outward as
  # a public exit must; the fire exit does the same at the east end.
  door    id=d_main on shell at 66208 width 2400 hinge left swing out
  door    id=d_exit on shell at 35100 width 1200 hinge left swing out
  opening id=o_g1 on w_spine at 4000  width 3000
  opening id=o_g2 on w_spine at 13000 width 3000
  opening id=o_g3 on w_spine at 22000 width 3000
  opening id=o_foyer on w_south at 4000  width 3000
  door    id=d_shop  on w_south at 10500 width 1200 swing into r_shop
  opening id=o_cafe  on w_south at 16000 width 2400
  door    id=d_wc    on w_south at 20500 width 1000 swing into r_wc
  door    id=d_plant on w_south at 24000 width 900  swing into r_plant

  window id=win_n1  on shell at 4000  width 3000
  window id=win_n2  on shell at 13000 width 4000
  window id=win_n3  on shell at 22000 width 3000
  window id=win_w   at (0,5000)  width 2400 wall shell
  window id=win_cafe on shell at 56000 width 3000

  furniture id=f_bench1 bench at (3400,9400)  size 2400x600 label "Bench" in r_g1
  furniture id=f_bench2 bench at (11800,9400) size 2400x600 label "Bench" in r_g2
  furniture id=f_bench3 bench at (21400,9400) size 2400x600 label "Bench" in r_g3
  furniture id=f_bench4 bench at (6000,11400)  size 2400x600 label "Bench" in r_concourse
  furniture id=f_bench5 bench at (17000,11400) size 2400x600 label "Bench" in r_concourse
  furniture id=f_till  counter in r_shop anchor left flush size 700x2400 label "Till"
  furniture id=f_bar   counter in r_cafe anchor left flush size 700x2400 label "Counter"
  furniture id=f_ct1 table at (14600,14200) size 900x900 in r_cafe
  furniture id=f_ct2 table at (16200,14200) size 900x900 in r_cafe
  furniture id=f_ct3 table at (17600,14200) size 900x900 in r_cafe
  furniture id=f_wcp   wc    in r_wc anchor left  flush size 700x400
  furniture id=f_basin basin in r_wc anchor right flush size 450x600

  title { project "Gallery Wing" drawn_by "ArchCanvas" }
}
