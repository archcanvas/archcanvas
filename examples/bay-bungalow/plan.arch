plan "Bay Bungalow" {
  units mm
  grid 50
  paper A3 landscape
  north up
  dims auto overall

  # An L-shaped bungalow with two shapes a rectangle cannot express: a curved
  # bay bulging off the living room's north facade (a true arc, dimensioned with
  # its own radius leader), and a round snug at the end of the leg whose area is
  # the exact circle, not a tessellation.
  wall id=shell exterior thickness 250 {
    (0,0) (2400,0) arc (5400,0) radius 1900 cw (12400,0)
    (12400,6800) (7200,6800) (7200,12000) (0,12000) close
  }
  wall id=w_living partition thickness 100 { (5800,0) (5800,6800) }
  wall id=w_b1     partition thickness 100 { (9400,0) (9400,3800) }
  wall id=w_hall_n partition thickness 100 { (5800,3800) (12400,3800) }
  wall id=w_hall_s partition thickness 100 { (5800,5000) (12400,5000) }
  wall id=w_bath   partition thickness 100 { (9000,5000) (9000,6800) }
  wall id=w_leg    partition thickness 100 { (0,6800) (7200,6800) }
  wall id=w_dining partition thickness 100 { (5000,6800) (5000,9600) }
  wall id=w_snug   partition thickness 100 { (0,9600) (7200,9600) }
  wall id=w_entry  partition thickness 100 { (3400,9600) (3400,12000) }

  room id=r_living  at (0,0)       size 5800x6800 label "Living"    uses living
  room id=r_bed1    at (5800,0)    size 3600x3800 label "Bedroom 1" uses bedroom
  room id=r_bed2    at (9400,0)    size 3000x3800 label "Bedroom 2" uses bedroom
  room id=r_hall    at (5800,3800) size 6600x1200 label "Hall"      uses hall circulation
  room id=r_bath    at (5800,5000) size 3200x1800 label "Bath"      uses bath
  room id=r_util    at (9000,5000) size 3400x1800 label "Laundry"   uses utility
  room id=r_kitchen at (0,6800)    size 5000x2800 label "Kitchen"   uses kitchen
  room id=r_dining  at (5000,6800) size 2200x2800 label "Dining"    uses dining
  room id=r_entry   at (0,9600)    size 3400x2400 label "Entry"     uses entry
  room id=r_snug    circle at (5900,10800) radius 1200 label "Snug"

  door    id=d_front  on shell    at 35380 width 1000 hinge left swing into r_entry
  door    id=d_kitchen on w_snug  at 1700  width 900 swing into r_kitchen
  opening id=o_snug   on w_snug   at 5900  width 1100
  opening id=o_dining on w_dining at 1400  width 1200
  opening id=o_living on w_leg    at 2000  width 1400
  door    id=d_hall   on w_living at 4400  width 900 swing into r_hall
  door    id=d_bed1   on w_hall_n at 2000  width 800 swing into r_bed1
  door    id=d_bed2   on w_hall_n at 5000  width 800 swing into r_bed2
  door    id=d_bath   on w_hall_s at 1400  width 800 swing into r_bath
  door    id=d_util   on w_hall_s at 4600  width 800 swing into r_util

  # A window on the curve: `on <wall> at <pos>` walks the RUN, and an arc
  # contributes its true length, so the opening lands on the bay.
  window id=win_bay   on shell at 4000 width 1600
  window id=win_livw  at (0,3000)     width 1800 wall shell
  window id=win_bed1  at (7800,0)     width 1600 wall shell
  window id=win_bed2  at (10800,0)    width 1400 wall shell
  window id=win_b2e   at (12400,2000) width 900  wall shell
  window id=win_bath  at (8000,6800)  width 600  wall shell
  window id=win_util  at (10400,6800) width 600  wall shell
  window id=win_kit   at (0,9100)     width 1200 wall shell
  window id=win_din   at (7200,8200)  width 1400 wall shell
  window id=win_entry at (0,10800)    width 900  wall shell

  furniture id=f_sofa  sofa  in r_living anchor left  flush inset 400 size 2200x900
  furniture id=f_ltable table in r_living anchor bottom-right flush inset 500 size 1200x700
  furniture id=f_bed1  bed   in r_bed1 anchor top-left flush inset 300 size 1600x2100 label "Double"
  furniture id=f_ward1 wardrobe in r_bed1 anchor right flush size 600x1600
  furniture id=f_bed2  bed   in r_bed2 anchor top-left flush inset 300 size 1200x2000 label "Single"
  furniture id=f_tub   bathtub in r_bath anchor bottom flush size 1700x750
  furniture id=f_basin basin   in r_bath anchor left   flush size 450x600
  furniture id=f_wc    wc      in r_bath anchor right  flush size 700x400
  furniture id=f_wash  counter in r_util anchor bottom flush size 1600x600
  furniture id=f_sink  kitchen_sink against wall shell segment 7 offset 2900 in r_kitchen
  furniture id=f_stove stove        against wall shell segment 7 offset 3700 in r_kitchen
  furniture id=f_fridge fridge      against wall shell segment 7 offset 4500 in r_kitchen
  furniture id=f_dtable table in r_dining centered size 1200x1600 label "Dining"
  furniture id=f_ssofa sofa  at (5200,10300) size 1400x800 in r_snug

  title { project "Bay Bungalow" drawn_by "ArchCanvas" }
}
