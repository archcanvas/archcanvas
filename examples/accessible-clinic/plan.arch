plan "Accessible Clinic" {
  units mm
  grid 50
  paper A3 landscape
  north up
  dims auto all
  accTitle "Neighbourhood clinic — accessible floor plan"
  accDescr "A single-storey clinic: a waiting room off the entrance, three consulting rooms along the north facade, a 1800 mm corridor, an accessible WC, a treatment room, a staff room and a store."

  let W = 14000
  let D = 9000
  let SPINE = 3800     # consulting rooms take the north facade
  let CORR  = 1800     # corridor width — a wheelchair and a person can pass

  wall id=shell     exterior  thickness 250 { (0,0) (W,0) (W,D) (0,D) close }
  wall id=w_spine   partition thickness 100 { (0,SPINE) (W,SPINE) }
  wall id=w_c1      partition thickness 100 { (5000,0) (5000,SPINE) }
  wall id=w_c2      partition thickness 100 { (8000,0) (8000,SPINE) }
  wall id=w_c3      partition thickness 100 { (11000,0) (11000,SPINE) }
  wall id=w_service partition thickness 100 { (0,5600) (W,5600) }
  wall id=w_s1      partition thickness 100 { (2400,5600) (2400,D) }
  wall id=w_s2      partition thickness 100 { (7000,5600) (7000,D) }
  wall id=w_s3      partition thickness 100 { (10400,5600) (10400,D) }

  room id=r_wait     at (0,0)     size 5000x3800 label "Reception / Waiting" uses entry hall
  room id=r_con1     at (5000,0)  size 3000x3800 label "Consulting 1" uses office
  room id=r_con2     at (8000,0)  size 3000x3800 label "Consulting 2" uses office
  room id=r_con3     at (11000,0) size 3000x3800 label "Consulting 3" uses office
  room id=r_corridor at (0,SPINE) size 14000x1800 label "Corridor" uses circulation
  room id=r_wc       at (0,5600)     size 2400x3400 label "Accessible WC" uses wc
  room id=r_treat    at (2400,5600)  size 4600x3400 label "Treatment"     uses office
  room id=r_staff    at (7000,5600)  size 3400x3400 label "Staff"         uses utility
  room id=r_store    at (10400,5600) size 3600x3400 label "Store"         uses storage

  # Every leaf here is 900 mm or wider, and every one swings into the room it
  # serves so nothing ever sweeps the corridor.
  door    id=d_entry at (1200,0) width 1500 wall shell hinge left swing into r_wait
  opening id=o_wait  on w_spine at 3600 width 1800
  door    id=d_con1  on w_spine at 5800  width 1000 swing into r_con1
  door    id=d_con2  on w_spine at 8800  width 1000 swing into r_con2
  door    id=d_con3  on w_spine at 11800 width 1000 swing into r_con3
  door    id=d_wc    on w_service at 1200  width 1000 swing into r_wc
  door    id=d_treat on w_service at 4700  width 1000 swing into r_treat
  door    id=d_staff on w_service at 7600  width 1000 swing into r_staff
  door    id=d_store on w_service at 12200 width 1000 swing into r_store

  window id=win_wait  at (0,1900)     width 2000 wall shell
  window id=win_con1  at (6500,0)     width 1600 wall shell
  window id=win_con2  at (9500,0)     width 1600 wall shell
  window id=win_con3  at (12500,0)    width 1600 wall shell
  window id=win_corr  at (14000,4700) width 1200 wall shell
  window id=win_wc    at (0,7300)     width 600  wall shell
  window id=win_treat at (4700,9000)  width 1600 wall shell
  window id=win_staff at (8700,9000)  width 1400 wall shell

  # The accessible WC keeps its middle clear for a 1500 mm turning circle: the
  # pan and the basin sit on the far wall, nothing on the transfer side.
  furniture id=f_wc    wc    in r_wc anchor bottom-right flush size 400x700
  furniture id=f_basin basin in r_wc anchor right         flush size 450x600

  furniture id=f_bench1 bench in r_wait anchor bottom-left flush inset 300 size 1600x600 label "Waiting"
  furniture id=f_desk0  desk  in r_wait anchor top-right   flush inset 400 size 1600x800 label "Reception desk"
  furniture id=f_desk1  desk  in r_con1 anchor top-left  flush inset 400 size 1400x700 label "Desk"
  furniture id=f_desk2  desk  in r_con2 anchor top-left  flush inset 400 size 1400x700 label "Desk"
  furniture id=f_desk3  desk  in r_con3 anchor top-left  flush inset 400 size 1400x700 label "Desk"
  furniture id=f_bed1   bed   in r_con1 anchor bottom-right flush inset 300 size 800x1900 label "Couch"
  furniture id=f_bed2   bed   in r_con2 anchor bottom-right flush inset 300 size 800x1900 label "Couch"
  furniture id=f_bed3   bed   in r_con3 anchor bottom-right flush inset 300 size 800x1900 label "Couch"
  furniture id=f_treat  bed   in r_treat anchor bottom-left flush inset 400 size 2000x900 label "Treatment couch"
  furniture id=f_counter counter in r_staff anchor bottom flush size 2000x600
  furniture id=f_stable  table   in r_staff anchor right  flush inset 400 size 1400x800 label "Staff table"

  title { project "Neighbourhood Clinic" drawn_by "ArchCanvas" }
}
